        case "OpenApp":
            launchApplication();
            break;
        case "Login":
            input(object, value); // username field
            break;
        case "Input":
            input(object, value);
            break;
        case "Click":
            click(object);
            break;
        case "Verify":
            verify(object, value);
            break;
        case "Logout":
            logout();
            break;
        case "CloseApp":
            closeApplication();
            break;
    }
}

